# ═══════════════════════════════════════════════════════════════
#  SOVEREIGN — GDI Resilience Core
#  Environment Configuration
# ═══════════════════════════════════════════════════════════════

# ── Service Endpoints ────────────────────────────────────────
OLLAMA_URL=http://127.0.0.1:11434
MACH6_HEALTH_URL=http://localhost:3006/api/v1/health
MACH6_SERVICE_NAME=mach6-gateway

# ── Infrastructure ───────────────────────────────────────────
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ── Sovereign Daemon ────────────────────────────────────────
SOVEREIGN_CHECK_INTERVAL=5
SOVEREIGN_STATE_FILE=/tmp/sovereign-state.json
SOVEREIGN_LOCK_FILE=/tmp/sovereign.lock

# ── Firewall ─────────────────────────────────────────────────
SOVEREIGN_CHAIN_NAME=SOVEREIGN_STEALTH
SOVEREIGN_FIREWALL_MARKER=/tmp/sovereign-firewall-active

# ── Logging ──────────────────────────────────────────────────
SOVEREIGN_LOG_LEVEL=INFO
