# ═══════════════════════════════════════════════════════════════
#  GDI — Global Defense Intelligence
#  Environment Configuration
#  © 2026 Artifact Virtual — All rights reserved
# ═══════════════════════════════════════════════════════════════
#
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
#
#  Or run ./install.sh which does this automatically.
#
#  All values shown are defaults. Uncomment and modify as needed.
#  Lines starting with # are comments. Empty values use defaults.
#
# ═══════════════════════════════════════════════════════════════


# ── API Server ────────────────────────────────────────────────
# The FastAPI backend that serves the GDI frontend and API.

GDI_API_HOST=0.0.0.0                      # Bind address (0.0.0.0 = all interfaces)
GDI_API_PORT=8600                          # HTTP port
GDI_JWT_SECRET=                            # Auto-generated by install.sh if empty
GDI_DEBUG=false                            # Enable debug mode (verbose logging, auto-reload)
GDI_LOG_LEVEL=INFO                         # Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL


# ── Database (PostgreSQL + PostGIS) ───────────────────────────
# Optional: only required for SATx signal ingestion pipeline.
# GDI works without PostgreSQL — most features use Redis/file cache.

# GDI_DB_HOST=localhost
# GDI_DB_PORT=5432
# GDI_DB_NAME=gdi_satx
# GDI_DB_USER=gdi
# GDI_DB_PASSWORD=
# GDI_DB_MIN_POOL=2
# GDI_DB_MAX_POOL=10


# ── SurrealDB ────────────────────────────────────────────────
# Optional: alternative/supplementary database backend.
# Used for graph-based intelligence correlation.

# SURREAL_URL=ws://localhost:8000/rpc
# SURREAL_USER=root
# SURREAL_PASS=
# SURREAL_NS=gdi
# SURREAL_DB=main


# ── Redis (Caching & Message Bus) ────────────────────────────
# Recommended for production. Falls back to file-based caching
# if unavailable. Also used as the inter-worker message bus.

REDIS_URL=redis://localhost:6379


# ── Frontend Map Tokens ──────────────────────────────────────
# These are client-side API keys served via /api/config/frontend.
# They're visible in the browser — not secrets, but kept here
# to stay out of git-tracked source files.

# CESIUM_ION_TOKEN=                        # CesiumJS ion access token
# GOOGLE_MAPS_API_KEY=                     # Google Maps JavaScript API key


# ── Ground Station Location ──────────────────────────────────
# Used for satellite pass predictions, ADS-B range calculations,
# and geographic reference in the HUD.

GDI_STATION_NAME=HOME
GDI_STATION_LAT=33.6844                   # Latitude (decimal degrees)
GDI_STATION_LON=73.0479                   # Longitude (decimal degrees)
GDI_STATION_ELEV=508                       # Elevation (meters above sea level)


# ── SATx (Signal Intelligence Pipeline) ──────────────────────
# Configuration for the SDR ground station data pipeline.
# Only needed if running physical SDR hardware integration.

# SATX_DATA_DIR=./data                    # Base directory for SATx output
# SATX_WATCH=true                         # Enable filesystem watch for new signals
# SATX_WATCH_INTERVAL=15                  # Watch poll interval (seconds)


# ── Alert Thresholds ─────────────────────────────────────────
# Signal-to-noise ratio thresholds for alert generation.

# GDI_ALERT_SNR_WARNING=15.0              # SNR above this → WARNING alert
# GDI_ALERT_SNR_CRITICAL=25.0             # SNR above this → CRITICAL alert


# ── Flight Data Sources (OSINT) ──────────────────────────────
# OpenSky Network credentials (optional, increases rate limits).
# Free tier works without credentials but has lower API limits.

# OPENSKY_USER=
# OPENSKY_PASS=


# ── TomTom Traffic API ───────────────────────────────────────
# Used for the traffic flow overlay layer.
# Free tier: 50K tile requests/day. Get key at developer.tomtom.com

# TOMTOM_API_KEY=


# ── Discord Bot ──────────────────────────────────────────────
# Optional: enables the GDI Discord bot for alerts, queries,
# and remote command interface.

# DISCORD_BOT_TOKEN=                      # Bot token from Discord Developer Portal
# DISCORD_ALERT_CHANNEL=                  # Channel ID for intel alerts
# DISCORD_COMMAND_PREFIX=!gdi             # Bot command prefix


# ── MQTT Bridge ──────────────────────────────────────────────
# Optional: MQTT integration for IoT sensor data and
# inter-service communication.

# MQTT_BROKER=localhost
# MQTT_PORT=1883
# MQTT_USER=
# MQTT_PASS=
# MQTT_TOPIC_PREFIX=gdi/


# ── Worker Configuration ─────────────────────────────────────
# Controls the intelligence collection worker daemons.

# GDI_WORKER_OSINT_ENABLED=true           # OSINT worker (RSS, news, social)
# GDI_WORKER_OSINT_INTERVAL=300           # Collection interval (seconds)
# GDI_WORKER_FININT_ENABLED=true          # FININT worker (financial intel)
# GDI_WORKER_FININT_INTERVAL=600          # Collection interval (seconds)
# GDI_WORKER_GEOINT_ENABLED=true          # GEOINT worker (satellite, spatial)
# GDI_WORKER_GEOINT_INTERVAL=900          # Collection interval (seconds)


# ── LLM Gateway ──────────────────────────────────────────────
# AI-powered analysis and summarization of intelligence data.
# Supports multiple backends.

# LLM_PROVIDER=openai                     # openai, anthropic, local, ollama
# LLM_API_KEY=                            # API key for cloud providers
# LLM_MODEL=gpt-4o                        # Model to use
# LLM_BASE_URL=                           # Custom endpoint (for local/ollama)
# LLM_MAX_TOKENS=4096                     # Max tokens per request
# LLM_TEMPERATURE=0.3                     # Temperature for analysis


# ── Sovereign (Resilience Layer) ──────────────────────────────
# Self-healing and failover configuration.

# SOVEREIGN_ENABLED=false                 # Enable resilience daemon
# SOVEREIGN_HEARTBEAT_INTERVAL=30         # Health check interval (seconds)
# SOVEREIGN_MAX_RESTARTS=5                # Max auto-restarts before escalation
# SOVEREIGN_ALERT_WEBHOOK=               # Webhook URL for failure alerts
